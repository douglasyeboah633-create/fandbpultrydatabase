# Copy this file to ".env" and put in your own values.
# ".env" is ignored by git, so your password never reaches GitHub.

MANAGER_NAME=Farm Manager
MANAGER_USERNAME=manager
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=change-this-to-a-long-password

# When you host the app (Render / Railway / PythonAnywhere) do NOT use a .env
# file - set these in the hosting provider's environment settings instead:
#   MANAGER_USERNAME, MANAGER_EMAIL, MANAGER_PASSWORD, JWT_SECRET
# JWT_SECRET=some-long-random-text
